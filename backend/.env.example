# ─── cyberPink backend — configuration ───────────────────────────────────────
# Copie ce fichier en `.env` (Linux/macOS : cp .env.example .env ; Windows : copy .env.example .env)
# puis adapte les valeurs. Le fichier doit rester enregistré en UTF-8.

# Mode de l'application :
#   debug       -> base SQLite locale : ../db/cyberpink.db (rien d'autre à configurer)
#   production  -> base distante Turso (les 3 variables ci-dessous sont alors obligatoires)
APP_MODE=debug

# Secret servant à signer les jetons de session (voir security.py).
# Obligatoire en production (32 caractères minimum). Génère-en un avec : openssl rand -hex 32
AUTH_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Turso (utilisé uniquement si APP_MODE=production)
TURSO_DATABASE_URL=libsql://ta-base-ton-organisation.turso.io
TURSO_AUTH_TOKEN=

# Origine(s) autorisées à appeler cette API (le frontend, servi ailleurs).
# Liste séparée par des virgules. Vide ou absent = "*" (toutes origines autorisées) ;
# c'est possible sans risque ici car l'authentification est par jeton (Authorization),
# jamais par cookie. Pour restreindre : CORS_ORIGINS=http://localhost:8080,https://cyberpink.app
CORS_ORIGINS=

# Dossier de la base SQLite locale (mode debug uniquement). Par défaut : le dossier db/ voisin
# de backend/ (dans Docker : /app/db, à monter en volume pour conserver les données).
# DB_DIR=
